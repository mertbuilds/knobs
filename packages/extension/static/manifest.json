{
  "manifest_version": 3,
  "name": "devknobs",
  "version": "0.0.0",
  "description": "The devknobs panel on any page, with text size, offline, media preferences and device sizes set for real.",
  "permissions": [
    "debugger",
    "declarativeNetRequestWithHostAccess",
    "offscreen",
    "storage",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "devknobs",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png" }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [{ "resources": ["bezels/*"], "matches": ["<all_urls>"] }],
  "icons": { "16": "icon-16.png", "32": "icon-32.png" }
}
